# RH Negativo V2 · Playwright
# Copiar como .env.test dentro de frontend y completar credenciales.

# =============================================================
# LOCAL
# =============================================================
PW_BASE_URL=http://localhost:3000
PW_API_URL=http://localhost:3001/routes
PW_LOCAL_USER=
PW_LOCAL_PASSWORD=

# =============================================================
# HOSTINGER
# Para probar TODO ya desplegado, comentar las URL locales y usar ambas remotas.
# Para frontend local contra API Hostinger, dejar PW_BASE_URL local y cambiar sólo PW_API_URL.
# =============================================================
#PW_BASE_URL=https://TU-DOMINIO-RH
#PW_API_URL=https://TU-DOMINIO-RH/api/routes
PW_HOSTINGER_USER=
PW_HOSTINGER_PASSWORD=

PW_BACKEND_DIR=../backend
PW_FRONTEND_COMMAND=npm start
# Windows con php.ini específico, si hace falta:
#PW_PHP_COMMAND=php -c "C:\php\php.ini" -S localhost:3001
PW_FINAL_CLEANUP=true
PW_ALLOW_DB_CLEANUP=false
