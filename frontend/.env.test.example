# RH Negativo V2 · Playwright
# Copiar como .env.test dentro de frontend.
# El entorno se elige EXCLUSIVAMENTE en frontend/.env -> REACT_APP_API_URL.

PW_LOCAL_USER=
PW_LOCAL_PASSWORD=
PW_HOSTINGER_USER=
PW_HOSTINGER_PASSWORD=

PW_LOCAL_BASE_URL=http://localhost:3000
PW_FRONTEND_COMMAND=npm start
PW_BACKEND_DIR=../backend
# Windows con php.ini específico:
#PW_PHP_COMMAND=php -c "C:\php\php.ini" -S localhost:3001
# Alternativa:
PW_PHP_COMMAND=php -S localhost:3001

PW_FINAL_CLEANUP=true
PW_ALLOW_DB_CLEANUP=false
PW_HOSTINGER_API_GAP_MS=120
PW_HOSTINGER_BROWSER_API_GAP_MS=120
PW_HOSTINGER_TEST_GAP_MS=220
