# RH Negativo V2 · Playwright
# Copiar como frontend/.env.test y completar las credenciales una sola vez.
#
# IMPORTANTE:
# EL ENTORNO NO SE ELIGE ACÁ.
# Para cambiar LOCAL <-> HOSTINGER modificá únicamente:
# frontend/.env -> REACT_APP_API_URL

# =============================================================
# CREDENCIALES LOCAL
# =============================================================
PW_LOCAL_USER=
PW_LOCAL_PASSWORD=

# =============================================================
# CREDENCIALES HOSTINGER
# =============================================================
PW_HOSTINGER_USER=
PW_HOSTINGER_PASSWORD=

# =============================================================
# FRONTEND LOCAL
# Se usa automáticamente cuando frontend/.env apunta a localhost.
# =============================================================
PW_LOCAL_BASE_URL=http://localhost:3000
PW_FRONTEND_COMMAND=npm start

# Opcional: sólo si el frontend de producción NO está en el mismo dominio
# que REACT_APP_API_URL. En RH Negativo actual no hace falta definirlo.
#PW_HOSTINGER_BASE_URL=https://TU-DOMINIO-RH

# =============================================================
# BACKEND LOCAL
# Se usa automáticamente cuando frontend/.env apunta a localhost.
# =============================================================
PW_BACKEND_DIR=../backend
# Windows con php.ini específico, si hace falta:
#PW_PHP_COMMAND=php -c "C:\php\php.ini" -S localhost:3001

# =============================================================
# LIMPIEZA E2E
# =============================================================
PW_FINAL_CLEANUP=true
PW_ALLOW_DB_CLEANUP=false
