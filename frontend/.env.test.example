# RH Negativo V2 · Playwright
# Copiar como .env.test dentro de frontend y completar credenciales.

# === API local ===
PW_API_URL=http://localhost:3001/routes
PW_BASE_URL=http://localhost:3000
PW_LOCAL_USER=
PW_LOCAL_PASSWORD=

# Backend hermano de frontend: ../backend
PW_BACKEND_DIR=../backend
PW_FRONTEND_COMMAND=npm start
PW_FINAL_CLEANUP=true

# === Para probar frontend local contra Hostinger ===
# Comentar PW_API_URL local y usar la URL real, por ejemplo:
# PW_API_URL=https://TU-DOMINIO/api/routes
# PW_HOSTINGER_USER=
# PW_HOSTINGER_PASSWORD=
